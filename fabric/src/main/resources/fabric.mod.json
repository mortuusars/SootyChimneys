{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_page}",
    "sources": "${mod_github}"
  },
  "license": "${mod_license}",
  "icon": "${mod_id}_logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.mortuusars.sootychimneys.fabric.SootyChimneysFabric"
    ],
    "client": [
      "io.github.mortuusars.sootychimneys.fabric.client.SootyChimneysFabricClient"
    ],
    "jei_mod_plugin": [
      "io.github.mortuusars.sootychimneys.integration.jei.SootyChimneysJeiPlugin"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21.9",
    "java": ">=21",
    "fabric-api": "*",
    "forgeconfigapiport": ">=21.10.0"
  }
}
